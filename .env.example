MODE=demo
DEMO_CLOCK_SPEED=3600
TICK_SECONDS=2
PUBLIC_BASE_URL=http://localhost:8000
TZ=America/Los_Angeles
DATABASE_URL=sqlite:///data/liquid.db
PHOTO_STORAGE_DIR=data/photos
APP_SECRET=

ANTHROPIC_API_KEY=
APIFY_TOKEN=
RESEARCH_MODE=auto
HANDOFF_DIR=data/handoff
REPRICE_LOOP=false
CLAUDE_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_CHAT_ENABLED=true
OPENAI_TRUTH_CHECK=true
IDENTIFIER_PROVIDER=openai

BB_SERVER_URL=http://localhost:1234
BB_PASSWORD=
BB_WEBHOOK_SECRET=
BB_WEBHOOK_BASE_URL=http://127.0.0.1:8000
# The iMessage alias Liquid answers on (the dedicated email, not the Mac owner's phone number).
# Always required. Find the aliases with: uv run python scripts/imessage_accounts.py
BB_ALLOWED_DESTINATION=
# Group chats are ignored unless this is true. Leave it false.
BB_ALLOW_GROUP_CHATS=false
# Use * to accept separate conversations from every tester.
SELLER_HANDLE=*
REQUIRE_EBAY_ONBOARDING=true
EBAY_DEMO_MODE=false

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_ENVIRONMENT=sandbox
EBAY_SB_CLIENT_ID=
EBAY_SB_CLIENT_SECRET=
EBAY_SB_RUNAME=
EBAY_SB_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_SB_MERCHANT_LOCATION_KEY=
EBAY_SB_PAYMENT_POLICY_ID=
EBAY_SB_RETURN_POLICY_ID=
EBAY_SB_FULFILLMENT_POLICY_ID=
EBAY_SB_DEFAULT_CATEGORY_ID=

SHIPPO_API_KEY=

GOOGLE_OAUTH_CLIENT_JSON=./secrets/gcal_client.json
GOOGLE_TOKEN_JSON=./secrets/gcal_token.json
GMAIL_OAUTH_CLIENT_JSON=./secrets/gmail_client.json
GMAIL_OAUTH_REDIRECT_URI=
